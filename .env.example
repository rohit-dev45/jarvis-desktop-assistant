# Get a free key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Push-to-talk hotkey for --hotkey mode
JARVIS_HOTKEY=ctrl+alt+j
# faster-whisper model: tiny.en, base.en, small.en
JARVIS_WHISPER_MODEL=base.en
# true = Microsoft neural voice via edge-tts (needs internet); false = offline Windows SAPI voice
JARVIS_EDGE_TTS=false
JARVIS_WEB_SEARCH=true
